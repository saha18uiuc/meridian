# Meridian environment contract (Section 10 of the amended plan).
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Only NEXT_PUBLIC_* names may reach the client bundle.

# ---------------------------------------------------------------- browser-safe
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------ server-only
# secret
SUPABASE_SERVICE_ROLE_KEY=
# secret
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54522/postgres
APP_BASE_URL=http://localhost:3000

# Defaults are the local dev server, which is the offline path and needs no credential.
#
# Temporal Cloud is the same code with a different environment — `temporalTarget()` derives every
# connection from these names, so switching is these lines and nothing else. With API key
# authentication the endpoint is the *regional* gRPC one, not the per-namespace host:
#   TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233   e.g. us-west-2.aws.api.temporal.io:7233
#   TEMPORAL_NAMESPACE=<namespace>.<account>                 the account suffix is required
#   TEMPORAL_API_KEY=<key from the Cloud dashboard>          implies TLS on its own
#   TEMPORAL_TLS=true
#   TEMPORAL_UI_URL=https://cloud.temporal.io/namespaces/<namespace>.<account>
# Older mTLS-style namespaces use <namespace>.<account>.tmprl.cloud:7233 instead.
# Setting TEMPORAL_API_KEY also stops `pnpm dev:infra` starting a local server.
#
# The deployment this repository is configured against uses a Meridian-provisioned namespace whose
# API key EXPIRES 2026-09-03. Past that date every Temporal call fails to authenticate until the
# key is rotated in .env; the local dev server block above keeps working regardless.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
# secret; absent => the local dev server, which authenticates nothing
TEMPORAL_API_KEY=
# Turns TLS on without an API key: a self-hosted deployment behind TLS. Cloud implies it anyway.
TEMPORAL_TLS=false
TEMPORAL_TASK_QUEUE=meridian-receiving
TEMPORAL_UI_URL=http://127.0.0.1:8233
WORKER_HEALTH_PORT=9464
WORKER_MAX_CONCURRENT_ACTIVITIES=20
WORKER_MAX_CONCURRENT_WORKFLOWS=10
AGENT_MAX_CONCURRENCY=4

# secret; absent => mock review/extraction only
OPENAI_API_KEY=
AI_REVIEW_MODEL=gpt-5.5
AI_REASONING_EFFORT=high
AI_REVIEW_MODEL_FALLBACK=
AI_ALLOW_LOCAL_FALLBACK=false
AI_MODE=mock
AI_REVIEW_TIMEOUT_MS=120000
AI_REVIEW_MAX_RETRIES=2

# secret
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_USER_ID=meridian-demo
# Input to resolution only. `pnpm preflight` resolves this into
# .meridian/resolved-versions.json; recorded metadata is always concrete.
COMPOSIO_GMAIL_TOOLKIT_VERSION=latest

# hard safety switch: every live send/draft throws before contacting Composio when false
GMAIL_LIVE_MODE=false
GMAIL_ALLOWED_RECIPIENTS=
GMAIL_SEARCH_QUERY=label:INBOX newer_than:7d
GMAIL_MAX_RESULTS=25

BROWSER_ALLOWED_DOMAINS=
BROWSER_WRITE_ENABLED=false
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

OCR_ENABLED=false
OCR_MIN_TEXT_CHARS=200

STORAGE_BUCKET_EMAILS=emails
STORAGE_BUCKET_ATTACHMENTS=attachments
STORAGE_BUCKET_OCR=ocr
STORAGE_BUCKET_SCREENSHOTS=screenshots

DEMO_USER_EMAIL=demo@meridian.local
DEMO_USER_PASSWORD=meridian-demo-password
DEMO_OTHER_EMAIL=other@meridian.local
DEMO_OTHER_PASSWORD=meridian-other-password

LOG_LEVEL=info
# Where an agent escalates when it refuses to decide on its own.
OPERATOR_EMAIL=operator@meridian.local
EVAL_REPAIR_MAX_ITERATIONS=3
EVAL_CONCURRENCY=4
MERIDIAN_STATE_DIR=.meridian
