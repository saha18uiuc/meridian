{
  "name": "@meridian/ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./intake": {
      "types": "./dist/intake/index.d.ts",
      "import": "./dist/intake/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@composio/core": "0.14.1",
    "@meridian/agent-kit": "workspace:*",
    "@meridian/core": "workspace:*",
    "@meridian/evals": "workspace:*",
    "@meridian/generated-agents": "workspace:*",
    "@supabase/supabase-js": "2.111.0",
    "@temporalio/client": "1.21.1",
    "dotenv": "17.4.2",
    "openai": "7.3.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.15.6"
  }
}
